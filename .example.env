; 本文件可随源码交付；复制为本机 .env 后填写，真实凭证不纳入 Git。
; 生产关闭调试，公开异常响应仍由应用处理器脱敏。
APP_DEBUG = false
MPAY_ENV = production
; 本站不绑定固定网址；收银台链接使用本次访问域名。
; 通知及回跳的目标域名在后台应用管理中配置，不限制本站绑定的域名。
; 仅 development/testing 生效，主机和端口必须同时明确列出；生产忽略这些例外。
MPAY_HTTP_DEV_HOSTS =
MPAY_HTTP_DEV_PORTS =
; Cookie 随当前 HTTP/HTTPS 请求自动设置，无需填写协议开关。
; 使用 MPAY 专用空库及账号。集成测试另从 MPAY_TEST_CONFIG 读取隔离配置。
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = mpay_v1
DB_USER = mpay_v1
DB_PASS =
DEFAULT_LANG = zh-cn
