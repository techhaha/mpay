{
    "plugins": ["@prettier/plugin-php"],
    "overrides": [
        {
            "files": "app/**/*.php",
            "options": {
                "parser": "php",
                "phpVersion": "8.2",
                "tabWidth": 4,
                "useTabs": false,
                "printWidth": 100,
                "singleQuote": true,
                "endOfLine": "lf"
            }
        }
    ]
}