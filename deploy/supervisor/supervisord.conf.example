; 应用用户的独立 Supervisor 根配置，不接管全局实例或其他应用。
; 预先设置 MPAY_STATE_DIR、MPAY_LOG_DIR、MPAY_V1_ROOT、MPAY_PHP_BIN，目录须可写且位于 public 外。
; 将 mpay-v1.conf.example 保存为 MPAY_STATE_DIR/programs.conf。
[unix_http_server]
file=%(ENV_MPAY_STATE_DIR)s/supervisor.sock
chmod=0600

[supervisord]
pidfile=%(ENV_MPAY_STATE_DIR)s/supervisord.pid
logfile=%(ENV_MPAY_LOG_DIR)s/supervisord.log
childlogdir=%(ENV_MPAY_LOG_DIR)s
logfile_maxbytes=10MB
logfile_backups=3
umask=0077

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://%(ENV_MPAY_STATE_DIR)s/supervisor.sock

[include]
files=%(ENV_MPAY_STATE_DIR)s/programs.conf
