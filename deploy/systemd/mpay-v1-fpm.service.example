# 独立 FPM 实例；不停止或重启宝塔的共享 FPM。安装前替换 PHP 8.2 的实际绝对路径。
[Unit]
Description=MPAY V1 dedicated PHP-FPM
After=network.target

[Service]
Type=simple
# master 以 root 启动并按专属 pool 降权为 mpay；配置文件必须由部署管理员保护。
ExecStart=/www/server/php/82/sbin/php-fpm --nodaemonize --fpm-config /srv/mpay-v1/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=true

[Install]
WantedBy=multi-user.target
