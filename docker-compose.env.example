# ==============================================================================
# MPAY Docker Compose 部署环境变量模板
# 使用方法：复制本文件为 docker-compose.env，并按需修改
# cp docker-compose.env.example docker-compose.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础应用、镜像与端口设置
# ------------------------------------------------------------------------------
# 镜像名称与仓库地址（动态适配）：
# - 本地构建模式：可保持默认 mpay:latest
# - 预构建/远程仓库模式：可配置为 GitHub Packages（如 ghcr.io/nothing248/mpay:latest）、Docker Hub 或私有仓库
IMAGE_NAME=mpay:latest

# 宿主机映射的 Web HTTP 访问端口
APP_PORT=8080

# 宿主机映射的 PHP-FPM FastCGI 端口（仅在需要外部已有 Nginx 直连 FPM 时使用）
FPM_PORT=9000

# 运行模式：
# - all-in-one  : 一体化模式（内置 Nginx + PHP-FPM + Workers，默认推荐）
# - fpm-worker  : 组合模式（PHP-FPM + Workers，适合外部已有 Nginx 直连 FastCGI）
# - fpm         : 纯 PHP-FPM 模式
# - worker      : 纯后台 Workers 守护模式
CONTAINER_MODE=all-in-one

# 调试模式（生产环境必须为 false）
APP_DEBUG=false
MPAY_ENV=production
DEFAULT_LANG=zh-cn

# ------------------------------------------------------------------------------
# 2. 数据库连接设置
# ------------------------------------------------------------------------------
# 若使用 docker-compose.yml 自带的 MySQL 服务，保持 DB_HOST=mysql 即可；
# 若使用已有外部 MySQL（宿主机、云 RDS），请修改为对应主机地址（如 host.docker.internal 或 IP）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mpay_v1
DB_USER=mpay_v1
DB_PASS=mpay_secret_password

# 仅在使用自带 MySQL 容器时生效：
MYSQL_ROOT_PASSWORD=root_strong_password

# ------------------------------------------------------------------------------
# 3. 可选：全自动静默安装设置（设为 true 可免去 /install 网页安装）
# ------------------------------------------------------------------------------
# 首次启动是否自动检测数据库并一键建表与初始化管理员
AUTO_INSTALL=false

# 自动初始化的管理员用户名和密码（密码必须至少 12 位）
ADMIN_USER=admin
ADMIN_PASS=Admin1234567890
INIT_APP_NAME=默认应用
