    "docs/wiki/V1-30-收银台页面与扩展.md",
    "docs/wiki/V1-34-动态码收款插件.md"
  ],
  "crypto": [
    "app/common/sdk/crypto/GuomiCrypto.php",
    "app/common/sdk/crypto/third_party/splsm2/.gitattributes",
    "app/common/sdk/crypto/third_party/splsm2/SimpleSm2.php",
    "app/common/sdk/crypto/third_party/splsm2/SimpleSm4.php",
    "app/common/sdk/crypto/third_party/splsm2/Sm2Asn1.php",
    "app/common/sdk/crypto/third_party/splsm2/Sm2Ecc.php",
