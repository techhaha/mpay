# 原生 systemd 方案，与 Supervisor 二选一。仅启用 mpay-v1@work、mpay-v1@watch 两个实例。
# 替换本实例的用户、PHP 8.2 和项目绝对路径；此文件没有安装或启动任何服务。
[Unit]
Description=MPAY V1 %i worker
After=network.target

[Service]
Type=simple
User=mpay
Group=mpay
WorkingDirectory=/srv/mpay-v1/app
ExecStart=/www/server/php/82/bin/php /srv/mpay-v1/app/think payment:%i
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
