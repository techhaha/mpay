# 独立站点 HTTPS 模板，放入 http 上下文。与 HTTP 模板二选一，避免重复 map 名称。
# 仅替换本实例域名、证书、public 与 socket 路径；证书必须覆盖 server_name 中每个实际域名。
# 这里不要求一个固定的应用域名；新增同站域名只需更新 Web/TLS 配置。
map $request_uri $mpay_v1_path_info {
    ~^([^?]*) $1;
}

server {
    listen 80;
    server_name pay.example.com pay-alt.example.com;
    access_log off;
    # 必须先使用 HTTPS 提交支付请求；跳转不能保护已经经 HTTP 传出的秘密。
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pay.example.com pay-alt.example.com;
    root /srv/mpay-v1/app/public;
    index index.php;
    ssl_certificate /srv/mpay-v1/tls/fullchain.pem;
    ssl_certificate_key /srv/mpay-v1/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MPAY_V1_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 3m;
    autoindex off;
    server_tokens off;
    access_log off;
    # Web 错误日志仍受限保存；不要打开 debug 级别或记录请求正文/查询参数的自定义日志。
    error_log /srv/mpay-v1/logs/nginx-error.log warn;
    # 标记放在 Nginx 可 stat 的专属 run 目录；建立后阻止新的 Web 请求进入 FPM。
    # 此标记不停止已在途请求和 CLI，备份/升级还须执行维护文档的停写步骤。
    if (-f /srv/mpay-v1/run/maintenance.flag) { return 503; }

    location ~ /\. { deny all; }
    location ~* ^/storage/.+\.(?:png|jpe?g|webp)$ {
        limit_except GET HEAD { deny all; }
        disable_symlinks on;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location /storage/ { return 404; }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param PATH_INFO $mpay_v1_path_info;
        # 由当前 TLS 站点设置协议，不信任客户端 Forwarded/X-Forwarded-Proto 覆盖。
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 65s;
        fastcgi_pass unix:/srv/mpay-v1/run/fpm.sock;
    }
    # .php 为兼容协议地址；磁盘上只执行固定 index.php。
    location ~ ^/(submit|mapi|api)\.php$ { rewrite ^ /index.php last; }
    location ~* \.php(?:/|$) { return 404; }
}
